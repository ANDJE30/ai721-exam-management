classDiagram
  direction LR
  class Etablissement {
    +nom, sigle, tutelle, ville
    +anneeScolaire
    +logo, styleEnTetePDF
    +seuilReussite, delaiSaisie
  }
  class Niveau {
    +code : 1 Seconde | 2 Première | 3 Terminale
    +prefet
  }
  class Classe {
    +nom
    +pole
    +rang (2 chiffres du code)
  }
  class Eleve {
    +matricule, nom, prenoms
    +sexe, dateNaissance
    +statut
  }
  class Matiere {
    +code (2 chiffres)
    +abreviation, intitule
  }
  class Enseignant {
    +civilite, nom, prenoms, telephone
  }
  class Programme {
    +coefficient
  }
  class Salle {
    +nom, capacite, batiment
  }
  class Evaluation {
    +trimestre 1..3
    +situation 1..6
    +date, debut, fin
    +bareme, doubleCorrection
    +statut, echeance
  }
  class Placement {
    +numeroTable 001..999
    +codeBarres()
  }
  class SalleAffectee {
    +tableDebut, tableFin
    +surveillants
  }
  class Note {
    +n, n2, n3
    +etat : P | ABS | DISP | FRAUDE
    +saisiePar, saisieLe, motifCorrection
  }
  class Anonymat {
    +leve : booleen
    +leveLe, levePar, forcee
  }
  class Utilisateur {
    +nom, email
    +role
    +prefectures
  }
  class EntreeJournal {
    +date, auteur, action, detail
  }
  Etablissement "1" --> "3" Niveau
  Niveau "1" --> "*" Classe
  Classe "1" --> "*" Eleve
  Classe "1" --> "*" Programme
  Programme "*" --> "1" Matiere
  Programme "*" --> "0..1" Enseignant
  Evaluation "*" --> "1" Matiere
  Evaluation "*" --> "1..*" Classe
  Evaluation "1" --> "*" Placement
  Placement "*" --> "1" Eleve
  Evaluation "1" --> "*" SalleAffectee
  SalleAffectee "*" --> "1" Salle
  Placement "1" --> "0..1" Note
  Evaluation "1" --> "1" Anonymat
  Utilisateur "1" --> "*" EntreeJournal
